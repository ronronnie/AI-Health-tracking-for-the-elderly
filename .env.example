# Copy to .env.local for local dev, and set these in Vercel → Project → Settings
# → Environment Variables for production.

# Public base URL of the FastAPI backend (the AI_Health_Lab service).
# Local dev:   http://localhost:8000
# Production:  https://<your-service>.onrender.com   (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Anthropic key. Used only by the built-in fallback route src/app/api/parse.
# The main flow calls the Python backend above, but set this so the fallback
# route works too. Keep it secret — never expose it as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=your-anthropic-key-here
